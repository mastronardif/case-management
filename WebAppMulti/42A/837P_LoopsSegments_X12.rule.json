{
  "ruleType": "837P_LoopsSegments_X12",
  "version": "2.2.0",
  "description": "Builds Loop 2400 service lines from session source documents, calculates billing values using the authorization, computes claim totals, and validates the completed canonical 837P claim.",

  "constants": {
    "serviceQualifier": "HC",
    "unitCode": "UN",
    "unitRate": 65.0,
    "_note_unitRate": "TODO: move unitRate to authorization doc when authorization projection is complete"
  },

  "loadDocuments": {
    "authorization": "metadata.sources.authorization"
  },

  "requiredFields": [
    "loops.2010AA.NM1.NM109",
    "loops.2010BA.NM1.NM109",
    "loops.2010BB.NM1.NM109",
    "loops.2300.REF_G1.REF02"
  ],

  "forEach": {
    "source": "metadata.sources.sessions",
    "loadDoc": "documentId",
    "appendTo": "loops.2400",

    "fields": [
      { "target": "source.documentId", "expression": "documentId" },
      { "target": "DTP472.DTP03", "source": "session.date" },
      { "target": "SV1.SV101_1", "expression": "constants.serviceQualifier" },
      { "target": "SV1.SV101_2", "source": "service.code" },
      { "target": "SV1.SV101_3", "source": "service.modifier" },
      { "target": "SV1.SV103", "expression": "constants.unitCode" },
      { "target": "computed.startTime", "source": "session.startTime" },
      { "target": "computed.endTime", "source": "session.endTime" },
      {
        "target": "computed.minutes",
        "expression": "minutes(session.startTime, session.endTime)"
      },
      {
        "target": "SV1.SV104",
        "expression": "ceiling(computed.minutes / authorization.minutesPerUnit)"
      },
      {
        "target": "SV1.SV102",
        "expression": "round(SV1.SV104 * constants.unitRate, 2)"
      },
      { "target": "computed.amount", "expression": "SV1.SV102" }
    ]
  },

  "rules": [
    {
      "field": "loops.2300.CLM.CLM02",
      "expression": "round(sum(loops.2400[*].SV1.SV102), 2)"
    }
  ],

  "validations": [
    {
      "field": "loops.2010AA.NM1.NM109",
      "expression": "length(value) == 10",
      "message": "Billing Provider NPI must be 10 digits."
    },
    {
      "field": "loops.2310B.NM1.NM109",
      "expression": "length(value) == 10",
      "message": "Rendering Provider NPI must be 10 digits."
    },
    {
      "field": "loops.2010BA.NM1.NM109",
      "expression": "notEmpty(value)",
      "message": "Subscriber Member ID is required."
    },
    {
      "field": "loops.2300.HI.HI01_2",
      "expression": "notEmpty(value)",
      "message": "Diagnosis Code is required."
    },
    {
      "field": "loops.2300.REF_G1.REF02",
      "expression": "notEmpty(value)",
      "message": "Authorization Number is required."
    }
  ]
}
